/DTFE_include/

# compiled objects, libraries, shared objects, executables, debug symbols
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.d
*.gch
*.pch
*.dSYM/

#  Python bytecode and pipeline outputs
__pycache__/
*.pyc
python/figures/
python/cache/

#  OS / IDE
.DS_Store
.idea/
.vscode/

#  Test scratch outputs (regenerable; the tracked baselines live in tests/reference/)
tests/tmp/

