# Minimal Linux CPU build + fast test battery. DELIBERATELY small: a previous
# cross-platform-test.yml was removed on purpose (commit eb243c8), so this workflow stays
# one job, CPU-only, and under ~15 minutes -- it exists to catch "does not compile on
# Linux" and "the deposit broke" regressions, nothing more.
#
# DISABLED BY DEFAULT: rename to ci.yml to enable (see the README 'Tests' section).
# NOTE: the tests/ directory is git-ignored in this repository; enabling CI on a fresh
# clone requires either tracking tests/ or vendoring the two entry points used below.

name: linux-cpu

on:
  push:
    branches: [master]
  pull_request:

jobs:
  build-and-test:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4

      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            build-essential libgsl-dev libboost-all-dev libcgal-dev \
            libmpfr-dev libhdf5-dev libgmp-dev libfftw3-dev \
            python3 python3-numpy python3-h5py

      - name: Check dependencies
        run: make deps-check

      - name: Build DTFE + PS-DTFE (CPU-only)
        run: |
          make DTFE    ARCH_FLAGS="-mtune=generic" -j"$(nproc)"
          make PS-DTFE ARCH_FLAGS="-mtune=generic" -j"$(nproc)"

      - name: Standard-DTFE regression
        run: python3 tests/run_tests.py

      - name: PS-DTFE smoke test
        run: tests/ps_smoke_test.sh --no-build
